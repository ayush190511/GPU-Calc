---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import ScrollToTop from '../components/ScrollToTop.astro';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = 'GPUCalc — AI Model VRAM & Cloud GPU Cost Estimator',
  description = 'Real-time VRAM calculator and live cloud GPU cost comparison for LLMs, Diffusion models, and fine-tuning across RunPod, Lambda Labs, Vast.ai, AWS, and GCP.',
  image = '/og-image.png',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://gpucalc.ai');
---

<!doctype html>
<html lang="en" class="dark scroll-smooth scroll-pt-24">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />

    <!-- Inline script to prevent theme flash -->
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          if (stored === 'light') {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          } else if (stored === 'dark') {
            document.documentElement.classList.remove('light');
            document.documentElement.classList.add('dark');
          } else if (window.matchMedia('(prefers-color-scheme: light)').matches) {
            document.documentElement.classList.remove('dark');
            document.documentElement.classList.add('light');
          } else {
            document.documentElement.classList.remove('light');
            document.documentElement.classList.add('dark');
          }
        } catch (e) {}
      })();
    </script>

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="keywords" content="GPU VRAM calculator, LLM memory requirement, cloud GPU pricing, RunPod pricing, Lambda Labs vs AWS, DeepSeek VRAM, Llama 3 70B GPU, QLoRA memory calculator, H100 cost, RTX 4090 cloud rental" />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={image} />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={image} />

    <!-- Google Fonts: Inter & JetBrains Mono -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json" is:inline>
      {
        "@context": "https://schema.org",
        "@type": "SoftwareApplication",
        "name": "GPUCalc — AI Model VRAM & Cloud GPU Cost Estimator",
        "applicationCategory": "DeveloperApplication",
        "operatingSystem": "All",
        "offers": {
          "@type": "Offer",
          "price": "0",
          "priceCurrency": "USD"
        },
        "description": "Deterministic VRAM sizing engine and live multi-cloud GPU pricing calculator for LLMs, Diffusion models, and fine-tuning across RunPod, Lambda Labs, Vast.ai, AWS, and GCP.",
        "featureList": [
          "Model weights calculation across FP32, FP16, FP8, and INT4 precision",
          "KV-cache context scaling with Grouped Query Attention (GQA)",
          "AdamW optimizer and gradient memory calculation for QLoRA and LoRA",
          "Real-time spot and on-demand cloud pricing comparison"
        ]
      }
    </script>
  </head>
  <body class="font-sans antialiased min-h-screen flex flex-col">
    <!-- Background Ambient Glow & Grid -->
    <div class="fixed inset-0 pointer-events-none -z-10 overflow-hidden">
      <div class="absolute -top-40 left-1/2 -translate-x-1/2 w-[800px] h-[500px] bg-gradient-to-tr from-indigo-600/20 via-violet-600/15 to-cyan-500/15 blur-[130px] rounded-full"></div>
      <div class="absolute top-[800px] -left-40 w-[600px] h-[400px] bg-purple-600/15 blur-[120px] rounded-full"></div>
      <div class="absolute inset-0 bg-grid-pattern"></div>
    </div>

    <!-- Navigation Header -->
    <header class="sticky top-0 z-50 backdrop-blur-xl bg-slate-950/85 border-b border-slate-800/80 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 flex items-center justify-between">
        <!-- Solid High-Contrast Logo -->
        <a href="/" class="flex items-center gap-3 group">
          <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-indigo-500 via-indigo-600 to-cyan-400 p-[1.5px] shadow-lg shadow-indigo-500/25 group-hover:shadow-indigo-500/50 transition-all duration-300">
            <div class="w-full h-full bg-slate-950 rounded-[10px] flex items-center justify-center relative overflow-hidden">
              <!-- Solid Microchip Icon SVG -->
              <svg class="w-6 h-6 text-indigo-400 group-hover:scale-110 transition-transform duration-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <rect x="4" y="4" width="16" height="16" rx="2" fill="#4F46E5" fill-opacity="0.2"></rect>
                <rect x="8.5" y="8.5" width="7" height="7" rx="1.5" fill="#6366F1"></rect>
                <path d="M4 9H2M4 15H2M20 9H22M20 15H22M9 4V2M15 4V2M9 20V22M15 20V22" stroke="#38BDF8"></path>
              </svg>
            </div>
          </div>
          <div class="flex flex-col">
            <span class="font-black text-lg tracking-tight text-white flex items-center gap-1.5 leading-tight">
              GPU<span class="text-indigo-400">Calc</span>
              <span class="text-[9px] px-1.5 py-0.2 rounded-md bg-indigo-500/20 text-indigo-300 font-mono font-bold border border-indigo-500/30">
                PRO
              </span>
            </span>
            <span class="text-[10px] text-slate-400 font-mono tracking-wide">
              VRAM & Cloud Cost Lab
            </span>
          </div>
        </a>

        <!-- Desktop Nav Links -->
        <nav class="hidden md:flex items-center gap-6 text-xs font-semibold text-slate-300">
          <a href="/#calculator" class="hover:text-indigo-400 transition-colors">VRAM Sizer</a>
          <a href="/#pricing-matrix" class="hover:text-indigo-400 transition-colors">Live GPU Matrix</a>
          <a href="/#methodology" class="hover:text-indigo-400 transition-colors">Methodology</a>
          <a href="/about" class="hover:text-indigo-400 transition-colors">About</a>
          <a href="/contact" class="hover:text-indigo-400 transition-colors">Contact</a>
        </nav>

        <!-- Right Desktop Actions -->
        <div class="hidden sm:flex items-center gap-3">
          <ThemeToggle />
          <a
            href="/#pricing-matrix"
            class="px-4 py-2 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 hover:from-indigo-500 hover:to-violet-500 text-white text-xs font-bold shadow-md shadow-indigo-600/30 transition-all hover:scale-105"
          >
            Compare Rates
          </a>
        </div>

        <!-- Mobile Controls: Theme Toggle & Animated Hamburger Button -->
        <div class="flex items-center gap-2 md:hidden">
          <ThemeToggle />
          
          <!-- Animated Hamburger Button that transforms into a cross -->
          <button
            type="button"
            id="mobile-menu-btn"
            class="p-2.5 rounded-xl bg-slate-900 border border-slate-800 text-slate-200 hover:text-white flex flex-col justify-center items-center w-10 h-10 gap-1.5 focus:outline-none cursor-pointer transition-colors"
            aria-label="Toggle navigation menu"
            aria-expanded="false"
          >
            <span id="ham-bar-1" class="w-5 h-0.5 bg-current rounded-full transition-all duration-300 ease-in-out origin-center"></span>
            <span id="ham-bar-2" class="w-5 h-0.5 bg-current rounded-full transition-all duration-300 ease-in-out origin-center"></span>
            <span id="ham-bar-3" class="w-5 h-0.5 bg-current rounded-full transition-all duration-300 ease-in-out origin-center"></span>
          </button>
        </div>
      </div>

      <!-- Animated Mobile Navigation Drawer -->
      <div
        id="mobile-menu"
        class="max-h-0 opacity-0 overflow-hidden transition-all duration-300 ease-in-out md:hidden border-t border-slate-800/80 bg-slate-950/95 backdrop-blur-2xl px-4 space-y-3"
      >
        <a href="/#calculator" class="mobile-nav-link block py-2 text-sm font-medium text-slate-300 hover:text-indigo-400 transition-colors">VRAM Sizer Calculator</a>
        <a href="/#pricing-matrix" class="mobile-nav-link block py-2 text-sm font-medium text-slate-300 hover:text-indigo-400 transition-colors">Live GPU Matrix</a>
        <a href="/#methodology" class="mobile-nav-link block py-2 text-sm font-medium text-slate-300 hover:text-indigo-400 transition-colors">Formulas & Math</a>
        <a href="/about" class="mobile-nav-link block py-2 text-sm font-medium text-slate-300 hover:text-indigo-400 transition-colors">About GPUCalc</a>
        <a href="/contact" class="mobile-nav-link block py-2 text-sm font-medium text-slate-300 hover:text-indigo-400 transition-colors">Contact & Feedback</a>
        <a href="/privacy" class="mobile-nav-link block py-2 text-sm font-medium text-slate-300 hover:text-indigo-400 transition-colors">Privacy Policy</a>
        <div class="pt-2 pb-4">
          <a
            href="/#pricing-matrix"
            class="mobile-nav-link block text-center py-2.5 rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 text-white font-bold text-xs shadow-md"
          >
            Compare Cloud Rates
          </a>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
      <slot />
    </main>

    <!-- Floating Back to Top Button -->
    <ScrollToTop />

    <!-- Footer -->
    <footer class="border-t border-slate-800/80 bg-slate-950/90 text-xs text-slate-400 mt-20 transition-colors">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10">
        <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-5 gap-8 mb-8">
          <div class="space-y-3 sm:col-span-2 md:col-span-2">
            <div class="flex items-center gap-2.5">
              <div class="w-7 h-7 rounded-lg bg-indigo-600 flex items-center justify-center text-white font-black text-xs shadow-md shadow-indigo-600/30">
                G
              </div>
              <span class="font-extrabold text-slate-100 text-base">GPUCalc / VRAM Cost Lab</span>
            </div>
            <p class="text-slate-400 text-xs max-w-md leading-relaxed">
              The high-accuracy GPU memory sizing engine and live multi-cloud cost calculator for AI engineers, researchers, and infra architects.
            </p>
            <div class="flex flex-wrap items-center gap-2 text-slate-500 text-xs font-mono pt-1">
              <span>NVIDIA Blackwell B200</span>
              <span>•</span>
              <span>Hopper H100/H200</span>
              <span>•</span>
              <span>Ada RTX 4090 / 5090</span>
            </div>
          </div>

          <div>
            <h4 class="font-bold text-slate-200 mb-3 uppercase tracking-wider text-[11px]">Model Sizers</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/calculator/llama-3-3-70b" class="hover:text-indigo-400 transition-colors">Llama 3.3 70B VRAM</a></li>
              <li><a href="/calculator/deepseek-r1-671b" class="hover:text-indigo-400 transition-colors">DeepSeek R1 (671B MoE)</a></li>
              <li><a href="/calculator/qwen-2-5-32b" class="hover:text-indigo-400 transition-colors">Qwen 2.5 32B Sizer</a></li>
              <li><a href="/calculator/mistral-large-2-123b" class="hover:text-indigo-400 transition-colors">Mistral Large 2 (123B)</a></li>
              <li><a href="/calculator/gemma-2-27b" class="hover:text-indigo-400 transition-colors">Gemma 2 27B Sizer</a></li>
              <li><a href="/calculator/flux-1-schnell" class="hover:text-indigo-400 transition-colors">FLUX.1 Diffusion (12B)</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-slate-200 mb-3 uppercase tracking-wider text-[11px]">Pages & Tools</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="/#calculator" class="hover:text-indigo-400 transition-colors">VRAM Sizer Calculator</a></li>
              <li><a href="/#pricing-matrix" class="hover:text-indigo-400 transition-colors">Cloud GPU Price Matrix</a></li>
              <li><a href="/#faq" class="hover:text-indigo-400 transition-colors">Technical FAQ & Math</a></li>
              <li><a href="/#methodology" class="hover:text-indigo-400 transition-colors">Formulas & Benchmarks</a></li>
              <li><a href="/about" class="hover:text-indigo-400 transition-colors">About GPUCalc</a></li>
              <li><a href="/contact" class="hover:text-indigo-400 transition-colors">Contact & Feedback</a></li>
              <li><a href="/privacy" class="hover:text-indigo-400 transition-colors">Privacy Policy</a></li>
            </ul>
          </div>

          <div>
            <h4 class="font-bold text-slate-200 mb-3 uppercase tracking-wider text-[11px]">Cloud Providers</h4>
            <ul class="space-y-2 text-xs">
              <li><a href="https://runpod.io" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors">RunPod Cloud</a></li>
              <li><a href="https://lambdalabs.com" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors">Lambda Labs GPU Cloud</a></li>
              <li><a href="https://vast.ai" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors">Vast.ai Marketplace</a></li>
              <li><a href="https://aws.amazon.com/ec2/instance-types/p5/" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors">AWS EC2 Instances</a></li>
              <li><a href="https://cloud.google.com/compute/gpus-pricing" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors">GCP Compute Engine</a></li>
            </ul>
          </div>
        </div>

        <div class="pt-6 border-t border-slate-800 flex flex-col sm:flex-row items-center justify-between gap-3 text-[11px] text-slate-500">
          <p>© {new Date().getFullYear()} GPUCalc. Open-source tools for the AI community.</p>
          <div class="flex flex-wrap items-center gap-4">
            <a href="/about" class="hover:text-slate-400 transition-colors">About</a>
            <a href="/contact" class="hover:text-slate-400 transition-colors">Contact</a>
            <a href="/privacy" class="hover:text-slate-400 transition-colors">Privacy Policy</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Menu Animation & Hamburger-to-Cross Morph Script -->
    <script is:inline>
      function setupMobileMenu() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const bar1 = document.getElementById('ham-bar-1');
        const bar2 = document.getElementById('ham-bar-2');
        const bar3 = document.getElementById('ham-bar-3');

        if (!menuBtn || !mobileMenu) return;

        let isOpen = false;

        function toggleMenu(open) {
          isOpen = open !== undefined ? open : !isOpen;
          menuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

          if (isOpen) {
            // Open animation
            mobileMenu.classList.remove('max-h-0', 'opacity-0');
            mobileMenu.classList.add('max-h-[500px]', 'opacity-100', 'py-4');
            
            // Hamburger morph into Cross (X)
            if (bar1 && bar2 && bar3) {
              bar1.style.transform = 'translateY(8px) rotate(45deg)';
              bar2.style.opacity = '0';
              bar2.style.transform = 'scale(0)';
              bar3.style.transform = 'translateY(-8px) rotate(-45deg)';
            }
          } else {
            // Close animation
            mobileMenu.classList.remove('max-h-[500px]', 'opacity-100', 'py-4');
            mobileMenu.classList.add('max-h-0', 'opacity-0');

            // Reset Cross back to Hamburger
            if (bar1 && bar2 && bar3) {
              bar1.style.transform = 'none';
              bar2.style.opacity = '1';
              bar2.style.transform = 'none';
              bar3.style.transform = 'none';
            }
          }
        }

        menuBtn.onclick = (e) => {
          e.stopPropagation();
          toggleMenu();
        };

        // Close menu when clicking on any mobile nav link
        document.querySelectorAll('.mobile-nav-link').forEach((link) => {
          link.onclick = () => {
            toggleMenu(false);
          };
        });

        // Close menu when clicking outside
        document.addEventListener('click', (e) => {
          if (isOpen && !mobileMenu.contains(e.target) && !menuBtn.contains(e.target)) {
            toggleMenu(false);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupMobileMenu);
      } else {
        setupMobileMenu();
      }
      document.addEventListener('astro:after-swap', setupMobileMenu);
      document.addEventListener('astro:page-load', setupMobileMenu);
    </script>
  </body>
</html>
