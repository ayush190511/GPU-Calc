          <!-- Cloud GPU Providers -->
          <div>
            <h4 class="font-bold text-slate-200 mb-3.5 uppercase tracking-wider text-[11px]">
              <span>Cloud Providers</span>
            </h4>
            <ul class="space-y-2 text-xs">
              <li><a href="https://runpod.io" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors inline-flex items-center gap-1">RunPod Cloud ↗</a></li>
              <li><a href="https://lambdalabs.com" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors inline-flex items-center gap-1">Lambda Labs ↗</a></li>
              <li><a href="https://vast.ai" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors inline-flex items-center gap-1">Vast.ai Marketplace ↗</a></li>
              <li><a href="https://aws.amazon.com/ec2/instance-types/p5/" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors inline-flex items-center gap-1">AWS EC2 (P5/G5) ↗</a></li>
              <li><a href="https://cloud.google.com/compute/gpus-pricing" target="_blank" rel="noopener noreferrer" class="hover:text-indigo-400 transition-colors inline-flex items-center gap-1">GCP Compute ↗</a></li>
            </ul>
          </div>
        </div>

        <!-- Bottom Copyright & Privacy Notice Bar -->
        <div class="pt-6 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-slate-500">
          <div class="flex flex-wrap items-center gap-3">
            <span>© {new Date().getFullYear()} GPUCalc. Open-source tools for AI engineers.</span>
            <span class="hidden sm:inline">•</span>
            <span class="text-emerald-400 font-mono text-[10px]">Zero Telemetry & 100% Client-Side</span>
          </div>

          <div class="flex flex-wrap items-center gap-5">
            <a href="/about" class="hover:text-slate-300 transition-colors">About</a>
            <a href="/contact" class="hover:text-slate-300 transition-colors">Contact</a>
            <a href="/privacy" class="hover:text-slate-300 transition-colors">Privacy Policy</a>
            <a href="https://github.com/ayush190511/GPU-Calc" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">GitHub</a>
            <a href="https://www.linkedin.com/in/ayush190511/" target="_blank" rel="noopener noreferrer" class="hover:text-slate-300 transition-colors">LinkedIn</a>
          </div>
        </div>
      </div>
    </footer>

    <!-- Mobile Menu Animation & Hamburger-to-Cross Morph Script -->
    <script is:inline>
      function setupMobileMenu() {
        const menuBtn = document.getElementById('mobile-menu-btn');
        const mobileMenu = document.getElementById('mobile-menu');
        const bar1 = document.getElementById('ham-bar-1');
        const bar2 = document.getElementById('ham-bar-2');
        const bar3 = document.getElementById('ham-bar-3');

        if (!menuBtn || !mobileMenu) return;

        let isOpen = false;

        function toggleMenu(open) {
          isOpen = open !== undefined ? open : !isOpen;
          menuBtn.setAttribute('aria-expanded', isOpen ? 'true' : 'false');

          if (isOpen) {
            // Open animation
            mobileMenu.classList.remove('max-h-0', 'opacity-0');
            mobileMenu.classList.add('max-h-[500px]', 'opacity-100', 'py-4');
            
            // Hamburger morph into Cross (X)
            if (bar1 && bar2 && bar3) {
              bar1.style.transform = 'translateY(8px) rotate(45deg)';
              bar2.style.opacity = '0';
              bar2.style.transform = 'scale(0)';
              bar3.style.transform = 'translateY(-8px) rotate(-45deg)';
            }
          } else {
            // Close animation
            mobileMenu.classList.remove('max-h-[500px]', 'opacity-100', 'py-4');
            mobileMenu.classList.add('max-h-0', 'opacity-0');

            // Reset Cross back to Hamburger
            if (bar1 && bar2 && bar3) {
              bar1.style.transform = 'none';
              bar2.style.opacity = '1';
              bar2.style.transform = 'none';
              bar3.style.transform = 'none';
            }
          }
        }

        menuBtn.onclick = (e) => {
          e.stopPropagation();
          toggleMenu();
        };

        // Close menu when clicking on any mobile nav link
        document.querySelectorAll('.mobile-nav-link').forEach((link) => {
          link.onclick = () => {
            toggleMenu(false);
          };
        });

        // Close menu when clicking outside
        document.addEventListener('click', (e) => {
          if (isOpen && !mobileMenu.contains(e.target) && !menuBtn.contains(e.target)) {
            toggleMenu(false);
          }
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupMobileMenu);
      } else {
        setupMobileMenu();
      }
      document.addEventListener('astro:after-swap', setupMobileMenu);
      document.addEventListener('astro:page-load', setupMobileMenu);
    </script>
  </body>
</html>
