---
// Theme Toggle component
---

<button
  type="button"
  class="theme-toggle-btn p-2 rounded-xl bg-slate-800/60 hover:bg-slate-700/60 text-slate-300 hover:text-white border border-slate-700/60 transition-all duration-200 flex items-center justify-center focus:outline-none focus:ring-2 focus:ring-indigo-500/50 cursor-pointer"
  aria-label="Toggle dark/light color theme"
  title="Toggle dark/light mode"
>
  <!-- Sun Icon (Active when dark mode, click to switch to light) -->
  <svg
    class="theme-sun-icon w-4 h-4 text-amber-300 transition-transform duration-200 hover:rotate-45"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    viewBox="0 0 24 24"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2"></path>
    <path d="M12 20v2"></path>
    <path d="m4.93 4.93 1.41 1.41"></path>
    <path d="m17.66 17.66 1.41 1.41"></path>
    <path d="M2 12h2"></path>
    <path d="M20 12h2"></path>
    <path d="m6.34 17.66-1.41 1.41"></path>
    <path d="m19.07 4.93-1.41 1.41"></path>
  </svg>

  <!-- Moon Icon (Active when light mode, click to switch to dark) -->
  <svg
    class="theme-moon-icon w-4 h-4 text-indigo-600 hidden transition-transform duration-200 hover:-rotate-12"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    viewBox="0 0 24 24"
  >
    <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
  </svg>
</button>

<script is:inline>
  function updateThemeIcons() {
    const isLight = document.documentElement.classList.contains('light');
    document.querySelectorAll('.theme-sun-icon').forEach((el) => {
      if (isLight) {
        el.classList.add('hidden');
      } else {
        el.classList.remove('hidden');
      }
    });
    document.querySelectorAll('.theme-moon-icon').forEach((el) => {
      if (isLight) {
        el.classList.remove('hidden');
      } else {
        el.classList.add('hidden');
      }
    });
  }

  function setupThemeToggles() {
    updateThemeIcons();
    const toggleButtons = document.querySelectorAll('.theme-toggle-btn');
    toggleButtons.forEach((btn) => {
      // Remove old clone to prevent duplicate event listeners
      btn.onclick = () => {
        const isDark = !document.documentElement.classList.contains('light');
        if (isDark) {
          document.documentElement.classList.remove('dark');
          document.documentElement.classList.add('light');
          localStorage.setItem('theme', 'light');
        } else {
          document.documentElement.classList.remove('light');
          document.documentElement.classList.add('dark');
          localStorage.setItem('theme', 'dark');
        }
        updateThemeIcons();
      };
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupThemeToggles);
  } else {
    setupThemeToggles();
  }
  document.addEventListener('astro:after-swap', setupThemeToggles);
  document.addEventListener('astro:page-load', setupThemeToggles);
</script>
