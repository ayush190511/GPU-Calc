---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact & Feedback — GPUCalc"
  description="Submit new GPU benchmarks, report cloud pricing discrepancies, or request new model architecture presets."
>
  <div class="max-w-3xl mx-auto space-y-10 py-4">
    <!-- Header -->
    <div class="text-center space-y-3">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-800 border border-neutral-700/60 text-neutral-300 text-xs font-mono">
        <span>Community & Support</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-black text-white tracking-tight">
        Contact & Community Feedback
      </h1>
      <p class="text-xs sm:text-sm text-neutral-400 max-w-lg mx-auto">
        Have a new GPU architecture benchmark, noticed a cloud pricing change, or want to suggest a new LLM preset? Let us know!
      </p>
    </div>

    <!-- Contact Form Card -->
    <div class="rounded-2xl border border-neutral-800 bg-neutral-900/40 p-6 sm:p-8">
      <form id="contact-form" class="space-y-5">
        <!-- Category Selection -->
        <div>
          <label class="block text-xs font-semibold text-neutral-300 uppercase tracking-wider mb-2">
            Inquiry Category
          </label>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 text-xs">
            <label class="flex items-center gap-2 p-3 rounded-xl border border-neutral-800 bg-neutral-950 hover:border-neutral-700 cursor-pointer transition-colors">
              <input type="radio" name="category" value="gpu_pricing" checked class="text-white focus:ring-0 accent-white" />
              <span class="text-neutral-200">Report GPU Cloud Pricing Change</span>
            </label>
            <label class="flex items-center gap-2 p-3 rounded-xl border border-neutral-800 bg-neutral-950 hover:border-neutral-700 cursor-pointer transition-colors">
              <input type="radio" name="category" value="model_preset" class="text-white focus:ring-0 accent-white" />
              <span class="text-neutral-200">Request New Model Architecture</span>
            </label>
            <label class="flex items-center gap-2 p-3 rounded-xl border border-neutral-800 bg-neutral-950 hover:border-neutral-700 cursor-pointer transition-colors">
              <input type="radio" name="category" value="benchmark" class="text-white focus:ring-0 accent-white" />
              <span class="text-neutral-200">Submit Real-World VRAM Benchmark</span>
            </label>
            <label class="flex items-center gap-2 p-3 rounded-xl border border-neutral-800 bg-neutral-950 hover:border-neutral-700 cursor-pointer transition-colors">
              <input type="radio" name="category" value="general" class="text-white focus:ring-0 accent-white" />
              <span class="text-neutral-200">General Feedback / Partnership</span>
            </label>
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="name" class="block text-xs font-semibold text-neutral-300 mb-1.5">
              Your Name
            </label>
            <input
              type="text"
              id="name"
              required
              placeholder="e.g. Alex Turing"
              class="w-full px-3.5 py-2.5 bg-neutral-950 border border-neutral-800 rounded-xl text-xs text-neutral-100 placeholder-neutral-500 focus:outline-none focus:border-neutral-600"
            />
          </div>

          <div>
            <label for="email" class="block text-xs font-semibold text-neutral-300 mb-1.5">
              Email Address
            </label>
            <input
              type="email"
              id="email"
              required
              placeholder="alex@company.ai"
              class="w-full px-3.5 py-2.5 bg-neutral-950 border border-neutral-800 rounded-xl text-xs text-neutral-100 placeholder-neutral-500 focus:outline-none focus:border-neutral-600"
            />
          </div>
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold text-neutral-300 mb-1.5">
            Message / Details
          </label>
          <textarea
            id="message"
            rows="4"
            required
            placeholder="Include GPU model, cloud provider, batch size, or calculation details..."
            class="w-full px-3.5 py-2.5 bg-neutral-950 border border-neutral-800 rounded-xl text-xs text-neutral-100 placeholder-neutral-500 focus:outline-none focus:border-neutral-600 resize-none"
          ></textarea>
        </div>

        <button
          type="submit"
          class="w-full py-3 rounded-xl bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs transition-colors flex items-center justify-center gap-2"
        >
          <span>Send Feedback & Benchmark Data</span>
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
          </svg>
        </button>
      </form>

      <!-- Success Notification Box -->
      <div id="contact-success" class="hidden text-center py-8 space-y-3">
        <div class="w-12 h-12 rounded-full bg-neutral-800 text-white border border-neutral-700 flex items-center justify-center mx-auto text-xl font-bold">
          ✓
        </div>
        <h3 class="text-lg font-semibold text-white">Thank You for Your Feedback!</h3>
        <p class="text-xs text-neutral-400 max-w-sm mx-auto">
          Your submission has been recorded. Our maintainers review hardware benchmark submissions and cloud pricing updates regularly.
        </p>
        <button
          type="button"
          id="send-another"
          class="mt-2 text-xs text-white hover:underline font-medium"
        >
          Send another message
        </button>
      </div>
    </div>
  </div>

  <script is:inline>
    const form = document.getElementById('contact-form');
    const successBox = document.getElementById('contact-success');
    const sendAnotherBtn = document.getElementById('send-another');

    if (form && successBox) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        form.classList.add('hidden');
        successBox.classList.remove('hidden');
      });
    }

    if (sendAnotherBtn && form && successBox) {
      sendAnotherBtn.addEventListener('click', () => {
        form.reset();
        successBox.classList.add('hidden');
        form.classList.remove('hidden');
      });
    }
  </script>
</BaseLayout>
