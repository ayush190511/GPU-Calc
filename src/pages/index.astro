---
import BaseLayout from '../layouts/BaseLayout.astro';
import GpuCalcApp from '../components/react/GpuCalcApp';
import presetModelsData from '../data/preset-models.json';
import type { ModelPreset } from '../lib/calculations';

const models = presetModelsData as ModelPreset[];

const jsonLdFaq = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  'mainEntity': [
    {
      '@type': 'Question',
      'name': 'How do I calculate KV Cache and activation memory in transformers?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'KV-cache memory is calculated as: 2 × n_layers × n_kv_heads × head_dim × context_length × batch_size × bytes_per_param. With Grouped Query Attention (GQA), KV-cache footprint is reduced by up to 87.5%.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Why does PyTorch throw Out-of-Memory (OOM) errors during backpropagation?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Backpropagation requires storing intermediate activation tensors across all layers. Enabling gradient checkpointing recomputes activations on-the-fly, reducing activation memory by ~80%.',
      },
    },
    {
      '@type': 'Question',
      'name': 'How much VRAM does LoRA and QLoRA save compared to full fine-tuning?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'QLoRA 4-bit cuts memory requirements by >90% compared to full fine-tuning by quantizing base model weights to 4-bit NormalFloat and only updating low-rank adapter matrices.',
      },
    },
    {
      '@type': 'Question',
      'name': 'What is the cheapest cloud GPU provider for running open-source LLMs?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Specialized GPU cloud providers like RunPod, Lambda Labs, and Vast.ai offer spot rates up to 70-85% cheaper than hyperscalers, with RTX 4090 starting at $0.32/hr and A100 80GB at $1.39/hr.',
      },
    },
    {
      '@type': 'Question',
      'name': 'Can a 24 GB GPU (RTX 3090/4090/5090) run a 70B parameter model?',
      'acceptedAnswer': {
        '@type': 'Answer',
        'text': 'Yes! When quantized to 4-bit AWQ, GPTQ, or GGUF Q4_K_M, a 70B parameter model occupies ~38.5 GB, fitting on dual 24GB GPUs or a single GPU with partial RAM offloading.',
      },
    },
  ],
};
---

<BaseLayout
  title="GPUCalc — LLM VRAM Calculator & Cloud GPU Cost Estimator (2026)"
  description="Free LLM VRAM calculator and cloud GPU pricing comparison. Calculate exact memory footprints for inference, QLoRA fine-tuning, and KV-cache across RunPod, Lambda Labs, AWS, and GCP."
>
  <!-- FAQPage Structured Data -->
  <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLdFaq)} />

  <!-- Minimalist Header Section -->
  <section class="text-center pt-4 pb-6 relative max-w-4xl mx-auto">
    <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-neutral-900 border border-neutral-800 text-neutral-300 text-xs font-mono mb-3">
      <span class="h-1.5 w-1.5 rounded-full bg-neutral-400"></span>
      <span>Precision GPU Memory & Cloud Pricing Engine</span>
    </div>

    <h1 class="text-2xl sm:text-3xl lg:text-4xl font-bold tracking-tight text-white leading-tight">
      LLM VRAM Calculator & Cloud GPU Sizer
    </h1>

    <p class="text-xs sm:text-sm text-neutral-400 max-w-xl mx-auto mt-2 leading-relaxed">
      Accurately calculate GPU memory requirements for <b>Inference, QLoRA, and Full Fine-Tuning</b>. Compare real-time spot and on-demand cloud GPU rental costs.
    </p>
  </section>

  <!-- Minimalist Tool Showcase -->
  <section id="calculator" class="relative mb-12">
    <!-- Elevated tool card wrapper -->
    <div class="rounded-2xl border border-neutral-800 bg-neutral-900/30 backdrop-blur-xl p-4 sm:p-6 relative transition-all">
      <!-- Tool Accent Header Badge -->
      <div class="flex flex-wrap items-center justify-between gap-3 pb-3 mb-5 border-b border-neutral-800/80">
        <div class="flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-neutral-400"></span>
          <span class="text-xs font-semibold uppercase tracking-wider text-neutral-200">
            Interactive Calculator Console
          </span>
          <span class="text-[10px] px-2 py-0.5 rounded bg-neutral-800 text-neutral-300 border border-neutral-700 font-mono font-medium">
            Active
          </span>
        </div>

        <div class="hidden sm:flex items-center gap-3 text-[11px] text-neutral-400 font-mono">
          <span class="text-neutral-300">⚡ Real-time recalculation</span>
          <span>•</span>
          <span>15+ Presets</span>
          <span>•</span>
          <span>8 Cloud Providers</span>
        </div>
      </div>

      <GpuCalcApp client:load />
    </div>
  </section>

  <!-- Platform Capabilities & Metrics Bar (Positioned under the tool) -->
  <section class="max-w-5xl mx-auto mb-16">
    <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 text-left">
      <div class="p-3.5 rounded-xl bg-neutral-900/40 border border-neutral-800">
        <div class="text-[11px] text-neutral-400 font-medium">Model Architectures</div>
        <div class="text-lg sm:text-xl font-bold font-mono text-white mt-0.5">15+ Preloaded</div>
      </div>
      <div class="p-3.5 rounded-xl bg-neutral-900/40 border border-neutral-800">
        <div class="text-[11px] text-neutral-400 font-medium">Context Window Scaling</div>
        <div class="text-lg sm:text-xl font-bold font-mono text-white mt-0.5">Up to 128k Tokens</div>
      </div>
      <div class="p-3.5 rounded-xl bg-neutral-900/40 border border-neutral-800">
        <div class="text-[11px] text-neutral-400 font-medium">Cloud Providers Indexed</div>
        <div class="text-lg sm:text-xl font-bold font-mono text-white mt-0.5">8 Major Clouds</div>
      </div>
      <div class="p-3.5 rounded-xl bg-neutral-900/40 border border-neutral-800">
        <div class="text-[11px] text-neutral-400 font-medium">Quantization Formats</div>
        <div class="text-lg sm:text-xl font-bold font-mono text-white mt-0.5">FP32 • FP16 • FP8 • INT4</div>
      </div>
    </div>
  </section>

  <!-- Programmatic Model Directory Spokes -->
  <section class="mt-20">
    <div class="text-left mb-6 flex flex-col sm:flex-row sm:items-end justify-between gap-4">
      <div>
        <div class="inline-flex items-center gap-2 text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">
          <span>Model Sizing Hub</span>
        </div>
        <h2 class="text-xl sm:text-2xl font-bold text-white">Popular LLM VRAM Requirements Guides</h2>
        <p class="text-xs sm:text-sm text-neutral-400 mt-1">
          Explore dedicated memory calculators, architecture specifications, and GPU sizing guides for popular open-weights models.
        </p>
      </div>
      <span class="text-xs font-mono text-neutral-500 shrink-0">{models.length} Dedicated Hubs</span>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-3.5">
      {models.map((m) => (
        <a
          href={`/calculator/${m.slug || m.id}`}
          class="group p-4 rounded-xl border border-neutral-800 bg-neutral-900/30 hover:bg-neutral-900 hover:border-neutral-700 transition-all flex flex-col justify-between"
        >
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="text-[10px] px-2 py-0.5 rounded bg-neutral-800 text-neutral-300 border border-neutral-700 font-mono font-medium">
                {m.parametersB}B Params
              </span>
              <span class="text-[10px] text-neutral-500 font-mono">{m.family}</span>
            </div>
            <h3 class="font-semibold text-neutral-200 text-sm group-hover:text-white transition-colors">
              {m.name}
            </h3>
            <p class="text-xs text-neutral-400 mt-1.5 line-clamp-2 leading-relaxed">
              {m.description}
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-neutral-800/80 text-[11px] font-medium text-neutral-400 group-hover:text-white flex items-center justify-between transition-colors">
            <span>Calculate VRAM</span>
            <span class="group-hover:translate-x-0.5 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Common Deployment Scenarios Quick-Reference -->
  <section class="mt-20">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h2 class="text-xl sm:text-2xl font-bold text-white">Popular Sizing & Hardware Recipes</h2>
      <p class="text-xs sm:text-sm text-neutral-400 mt-1">
        Standard battle-tested deployment patterns for the most common open-source LLM workloads.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
      <!-- Scenario 1 -->
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/30 p-4 flex flex-col justify-between hover:border-neutral-700 transition-colors">
        <div>
          <div class="flex items-center justify-between text-xs mb-2">
            <span class="px-2 py-0.5 rounded bg-neutral-800 text-neutral-300 border border-neutral-700 font-medium text-[10px]">
              Budget Friendly
            </span>
            <span class="font-mono text-neutral-400 text-[11px]">$0.44/hr</span>
          </div>
          <h3 class="font-semibold text-neutral-200 text-sm">Llama 3.3 70B at Home</h3>
          <p class="text-xs text-neutral-400 mt-1 leading-relaxed">
            Running 70B on 1x RTX 4090 (24GB) using INT4 / AWQ quantization with 8k context window.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-neutral-800/80 text-[11px] font-mono text-neutral-300 flex justify-between">
          <span>VRAM: ~20.5 GB</span>
          <span class="text-white font-medium">1x RTX 4090</span>
        </div>
      </div>

      <!-- Scenario 2 -->
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/30 p-4 flex flex-col justify-between hover:border-neutral-700 transition-colors">
        <div>
          <div class="flex items-center justify-between text-xs mb-2">
            <span class="px-2 py-0.5 rounded bg-neutral-800 text-neutral-300 border border-neutral-700 font-medium text-[10px]">
              Sweet Spot
            </span>
            <span class="font-mono text-neutral-400 text-[11px]">$0.69/hr</span>
          </div>
          <h3 class="font-semibold text-neutral-200 text-sm">Qwen 2.5 32B FP8</h3>
          <p class="text-xs text-neutral-400 mt-1 leading-relaxed">
            Zero degradation 32B model on 1x RTX 5090 (32GB) or 1x L40S (48GB) with 32k context.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-neutral-800/80 text-[11px] font-mono text-neutral-300 flex justify-between">
          <span>VRAM: ~31.2 GB</span>
          <span class="text-white font-medium">1x RTX 5090</span>
        </div>
      </div>

      <!-- Scenario 3 -->
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/30 p-4 flex flex-col justify-between hover:border-neutral-700 transition-colors">
        <div>
          <div class="flex items-center justify-between text-xs mb-2">
            <span class="px-2 py-0.5 rounded bg-neutral-800 text-neutral-300 border border-neutral-700 font-medium text-[10px]">
              Training
            </span>
            <span class="font-mono text-neutral-400 text-[11px]">$0.22/hr</span>
          </div>
          <h3 class="font-semibold text-neutral-200 text-sm">8B QLoRA Fine-Tuning</h3>
          <p class="text-xs text-neutral-400 mt-1 leading-relaxed">
            Full parameter adapter tuning for Llama 3.1 8B with rank=16 and batch size 4 on 1x RTX 3090.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-neutral-800/80 text-[11px] font-mono text-neutral-300 flex justify-between">
          <span>VRAM: ~14.8 GB</span>
          <span class="text-white font-medium">1x RTX 3090</span>
        </div>
      </div>

      <!-- Scenario 4 -->
      <div class="rounded-xl border border-neutral-800 bg-neutral-900/30 p-4 flex flex-col justify-between hover:border-neutral-700 transition-colors">
        <div>
          <div class="flex items-center justify-between text-xs mb-2">
            <span class="px-2 py-0.5 rounded bg-neutral-800 text-neutral-300 border border-neutral-700 font-medium text-[10px]">
              Frontier Reasoning
            </span>
            <span class="font-mono text-neutral-400 text-[11px]">$27.50/hr</span>
          </div>
          <h3 class="font-semibold text-neutral-200 text-sm">DeepSeek-R1 (671B)</h3>
          <p class="text-xs text-neutral-400 mt-1 leading-relaxed">
            Running 671B full MoE in FP8 on an 8x H200 (141GB) or 4x B200 (192GB) supercluster.
          </p>
        </div>
        <div class="mt-4 pt-3 border-t border-neutral-800/80 text-[11px] font-mono text-neutral-300 flex justify-between">
          <span>VRAM: ~720 GB</span>
          <span class="text-white font-medium">8x H200 SXM</span>
        </div>
      </div>
    </div>
  </section>

  <!-- Mathematical Engine & Methodology Documentation -->
  <section id="methodology" class="mt-20 rounded-2xl border border-neutral-800 bg-neutral-900/20 p-6 sm:p-8">
    <div class="max-w-3xl mb-6">
      <div class="inline-flex items-center gap-2 text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-1">
        <span>Methodology</span>
      </div>
      <h2 class="text-xl sm:text-2xl font-bold text-white">Mathematical Methodology & Formulas</h2>
      <p class="text-xs sm:text-sm text-neutral-400 mt-1">
        GPU memory allocation in modern PyTorch, vLLM, and TensorRT-LLM is governed by deterministic equations across weights, KV-cache, activations, and optimizer states.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Weight formula -->
      <div class="p-4 rounded-xl bg-neutral-950 border border-neutral-800 space-y-2.5">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-200 flex items-center gap-2">
          <span>1. Model Weights Memory</span>
        </h3>
        <div class="p-2.5 rounded-lg bg-neutral-900/80 border border-neutral-800 font-mono text-xs text-neutral-200">
          M_weights = (Parameters × Bytes_per_Param) / 1024³
        </div>
        <p class="text-xs text-neutral-400 leading-relaxed">
          For FP16/BF16, each parameter requires <b>2 bytes</b>. For INT4/AWQ, parameters take <b>0.55 bytes</b> (including metadata, scaling factors, and zero-point overhead).
        </p>
      </div>

      <!-- KV Cache Formula -->
      <div class="p-4 rounded-xl bg-neutral-950 border border-neutral-800 space-y-2.5">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-200 flex items-center gap-2">
          <span>2. KV-Cache Context Memory</span>
        </h3>
        <div class="p-2.5 rounded-lg bg-neutral-900/80 border border-neutral-800 font-mono text-xs text-neutral-200">
          M_kv = 2 × n_layers × n_kv_heads × d_head × C × B × b_kv
        </div>
        <p class="text-xs text-neutral-400 leading-relaxed">
          Modern architectures (Llama 3, Mistral, Qwen) use <b>Grouped Query Attention (GQA)</b>, reducing the number of KV heads by 4x to 8x compared to query heads, drastically lowering context expansion costs.
        </p>
      </div>

      <!-- Training / Optimizer Formula -->
      <div class="p-4 rounded-xl bg-neutral-950 border border-neutral-800 space-y-2.5">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-200 flex items-center gap-2">
          <span>3. Training & AdamW Optimizer States</span>
        </h3>
        <div class="p-2.5 rounded-lg bg-neutral-900/80 border border-neutral-800 font-mono text-xs text-neutral-200">
          M_opt = Parameters_trainable × 12 Bytes
        </div>
        <p class="text-xs text-neutral-400 leading-relaxed">
          Full fine-tuning requires <b>4 bytes</b> for FP32 master weights, <b>4 bytes</b> for first momentum <code class="text-neutral-300">m</code>, and <b>4 bytes</b> for second momentum <code class="text-neutral-300">v</code>, totaling 12 bytes/param plus 2 bytes for gradients.
        </p>
      </div>

      <!-- Activation & Buffer Formula -->
      <div class="p-4 rounded-xl bg-neutral-950 border border-neutral-800 space-y-2.5">
        <h3 class="text-xs font-semibold uppercase tracking-wider text-neutral-200 flex items-center gap-2">
          <span>4. CUDA Runtime & PyTorch Buffer</span>
        </h3>
        <div class="p-2.5 rounded-lg bg-neutral-900/80 border border-neutral-800 font-mono text-xs text-neutral-200">
          M_total = (M_weights + M_kv + M_opt + M_act + 1.5GB) × 1.15
        </div>
        <p class="text-xs text-neutral-400 leading-relaxed">
          PyTorch and CUDA runtime kernels consume ~1.5 GB of context overhead. An additional <b>15% headroom buffer</b> prevents CUDA Out-Of-Memory (OOM) errors caused by memory fragmentation during dynamic batching.
        </p>
      </div>
    </div>
  </section>

  <!-- Quick Explore Pages Section -->
  <section class="mt-20">
    <div class="text-center max-w-2xl mx-auto mb-8">
      <h2 class="text-xl sm:text-2xl font-bold text-white">Explore More Resources & Support</h2>
      <p class="text-xs text-neutral-400 mt-1">
        Learn about our methodology, get in touch for custom benchmarks, or review our privacy policies.
      </p>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3.5">
      <a
        href="/about"
        class="group p-4 rounded-xl border border-neutral-800 bg-neutral-900/30 hover:bg-neutral-900 hover:border-neutral-700 transition-all"
      >
        <div class="w-7 h-7 rounded-lg bg-neutral-800 text-neutral-300 flex items-center justify-center mb-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
          </svg>
        </div>
        <h3 class="font-semibold text-neutral-200 text-sm group-hover:text-white transition-colors">About GPUCalc</h3>
        <p class="text-xs text-neutral-400 mt-1 leading-relaxed">
          Our engineering principles, hardware architecture benchmarks, and accuracy criteria.
        </p>
      </a>

      <a
        href="/contact"
        class="group p-4 rounded-xl border border-neutral-800 bg-neutral-900/30 hover:bg-neutral-900 hover:border-neutral-700 transition-all"
      >
        <div class="w-7 h-7 rounded-lg bg-neutral-800 text-neutral-300 flex items-center justify-center mb-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>
        </div>
        <h3 class="font-semibold text-neutral-200 text-sm group-hover:text-white transition-colors">Contact & Feedback</h3>
        <p class="text-xs text-neutral-400 mt-1 leading-relaxed">
          Submit new GPU benchmark data, report cloud price changes, or request new model presets.
        </p>
      </a>

      <a
        href="/privacy"
        class="group p-4 rounded-xl border border-neutral-800 bg-neutral-900/30 hover:bg-neutral-900 hover:border-neutral-700 transition-all"
      >
        <div class="w-7 h-7 rounded-lg bg-neutral-800 text-neutral-300 flex items-center justify-center mb-3">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>
        </div>
        <h3 class="font-semibold text-neutral-200 text-sm group-hover:text-white transition-colors">Privacy Policy</h3>
        <p class="text-xs text-neutral-400 mt-1 leading-relaxed">
          Zero data tracking, 100% client-side calculation privacy, and terms of use.
        </p>
      </a>
    </div>
  </section>
</BaseLayout>
