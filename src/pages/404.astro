---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 — GPU Cluster Node Not Found | GPUCalc"
  description="The requested page or GPU calculation configuration could not be found on this cluster node."
>
  <div class="py-12 sm:py-20 text-center max-w-2xl mx-auto space-y-6">
    <!-- Error Terminal Badge -->
    <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-neutral-800 border border-neutral-700/60 text-neutral-300 text-xs font-mono">
      <span class="w-2 h-2 rounded-full bg-neutral-400"></span>
      <span>ERROR: CUDA_DEVICE_NOT_FOUND (404)</span>
    </div>

    <div>
      <h1 class="text-7xl sm:text-9xl font-black font-mono tracking-tighter text-white">
        404
      </h1>
    </div>

    <h2 class="text-xl sm:text-2xl font-semibold text-white">
      GPU Node Offline or Page Missing
    </h2>

    <p class="text-sm text-neutral-400 leading-relaxed max-w-md mx-auto">
      The tensor pathway or route you were trying to access does not exist on this cluster. Let's redirect you back to the VRAM calculation engine.
    </p>

    <!-- Terminal error box -->
    <div class="rounded-xl border border-neutral-800 bg-neutral-950 p-4 font-mono text-left text-xs text-neutral-300 max-w-lg mx-auto space-y-1.5">
      <div class="flex items-center gap-1.5 pb-2 border-b border-neutral-800 text-neutral-500 text-[11px]">
        <div class="w-2 h-2 rounded-full bg-neutral-600"></div>
        <div class="w-2 h-2 rounded-full bg-neutral-600"></div>
        <div class="w-2 h-2 rounded-full bg-neutral-600"></div>
        <span class="ml-2 font-mono">gpucalc-node-terminal</span>
      </div>
      <div class="text-neutral-300">$ torch.cuda.get_device_properties(0)</div>
      <div class="text-neutral-400">RuntimeError: No CUDA-capable device is detected at current URL.</div>
      <div class="text-white font-semibold">→ Recommendation: Fallback to / (Home)</div>
    </div>

    <!-- Quick action links -->
    <div class="flex flex-wrap items-center justify-center gap-3 pt-4">
      <a
        href="/"
        class="px-5 py-2.5 rounded-xl bg-white hover:bg-neutral-200 text-neutral-950 font-semibold text-xs transition-colors"
      >
        Return to VRAM Calculator
      </a>
      <a
        href="/#pricing-matrix"
        class="px-4 py-2.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 border border-neutral-700 text-neutral-200 font-medium text-xs transition-colors"
      >
        View Cloud GPU Prices
      </a>
      <a
        href="/about"
        class="px-4 py-2.5 rounded-xl bg-neutral-800 hover:bg-neutral-700 border border-neutral-700 text-neutral-200 font-medium text-xs transition-colors"
      >
        About GPUCalc
      </a>
    </div>
  </div>
</BaseLayout>
